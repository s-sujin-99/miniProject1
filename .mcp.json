{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {}
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/serversequential-thinking"],
      "env": {}
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "shrimp-task-manager": {
      "command": "node",
      "args": ["D:\\claude\\mcp-shrimp-task-manager\\dist\\index.js"],
      "env": {
        "DATA_DIR": "D:\\claude\\miniProject1\\shrimp_data",
        "TEMPLATES_USE": "ko",
        "ENABLE_GUI": "true"
      }
    }
  }
}
